{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["react", "react/*", "react-dom", "react-dom/*", "preact", "preact/*", "@vitejs/plugin-react"],
            "message": "Constitución, Art. 3: React está prohibido."
          }
        ]
      }
    ]
  }
}
